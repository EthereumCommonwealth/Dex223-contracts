# Copy to .env and fill in. .env is gitignored; never commit real values.

# Deployer. Every Dex223 chain is deployed from 0x9467a00F2DFBF392254133ff36c291c618dF6f54 so the core
# contracts get the same address on every chain. Do not send any transaction from this key on a chain
# before its deployment: the address layout needs the deployer at nonce 0 there.
PRIVATE_KEY=

# Etherscan v2 key (one key covers every Etherscan-run explorer). The free plan does not cover
# Base, BNB Chain or OP Mainnet; those need a paid plan (or Blockscout for Base and OP).
ETHERSCAN_API_KEY=

# RPC overrides. Each defaults to a public endpoint in scripts/chains.ts; set a private one for deploys.
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
AVALANCHE_RPC_URL=
OPTIMISM_RPC_URL=
MONAD_RPC_URL=

# Local anvil fork used for rehearsals, and the chain it forks (a key of scripts/chains.ts).
FORK_RPC_URL=http://127.0.0.1:8546
FORK_CHAIN=mainnet

# Only for `yarn hardhat:test:gas`.
COINMARKETCAP_API_KEY=
